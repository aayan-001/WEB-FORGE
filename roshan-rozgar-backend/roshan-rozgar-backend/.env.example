PORT=3000
# SQLite file (use :memory: for throwaway runs)
DB_PATH=./data/roshan.db

# AI (optional). Without a key the backend runs on rule-based fallbacks so the demo never breaks.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash,gemini-3.6-flash,gemini-3.1-flash-lite
# studio (Google AI Studio keys, default) | vertex (Google Cloud Vertex AI keys)
GEMINI_PROVIDER=studio
# on | off  (off forces the fallbacks, useful for testing)
AI_MODE=on
AI_TIMEOUT_MS=10000

# Optional server-side speech-to-text (Whisper). The browser Web Speech API needs no key.
OPENAI_API_KEY=

CORS_ORIGIN=*
# Serve a built frontend from this folder (later step)
STATIC_DIR=
# Allows one-tap demo login as a seeded worker
DEMO_MODE=true
